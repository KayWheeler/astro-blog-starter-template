<style>
/* ==========================================================================
   MAKEROOM, makeroomexp.org
   Single stylesheet. Sections in order:
     1. Tokens          color, type and spacing custom properties
     2. Base            reset and document defaults
     3. Shared          grain, layout wrapper, labels, buttons, forms
     4. Home            hero, statement, program, experiment, people, close
     5. Footer
     6. Focus + motion
     7. Simple page     404 (scoped to .page-simple)
   Type is one family (Archivo); hierarchy comes from weight, width and case.
   Color is one warm-neutral ramp: the photographs carry all the color.
   ========================================================================== */


/* --- 1. TOKENS ----------------------------------------------------------- */
:root{
  /* one warm-neutral ramp: the photographs carry all the color */
  --paper:#E8E5DF;
  --paper-2:#DFDBD4;
  --ink:#17140F;
  --ink-2:#221E19;
  --gray-1:#5A544B;   /* secondary text on paper */
  --gray-2:#8C857A;   /* tertiary / text on ink */
  --gray-3:#C6C0B6;   /* body text on ink */
  --rule:#C8C3B8;
  --rule-ink:#3A352D;

  --gutter:clamp(20px,5vw,72px);
  --maxw:1440px;
  --col-gap:clamp(28px,4.4vw,64px);   /* the one gutter every grid uses */

  --f:"Archivo","Helvetica Neue",Helvetica,Arial,sans-serif;
}

/* --- 2. BASE ------------------------------------------------------------- */
*{box-sizing:border-box}

body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:var(--f);
  font-size:16px;
  font-weight:400;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}

img{max-width:100%;display:block}
a{color:inherit}
::selection{background:var(--ink);color:var(--paper)}

/* --- 3. SHARED ----------------------------------------------------------- */
/* paper grain */
.grain{
  position:fixed;inset:0;z-index:60;pointer-events:none;
  opacity:.45;mix-blend-mode:multiply;
}

/* layout wrapper */
.wrap{
  width:100%;max-width:var(--maxw);margin:0 auto;
  padding-inline:var(--gutter);
}

/* keyboard skip link: off-screen until focused */
.skip{
  position:absolute;left:-9999px;top:0;z-index:100;
  background:var(--ink);color:var(--paper);
  padding:14px 22px;text-decoration:none;
  font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;
}
.skip:focus{left:0}

.eyebrow{
  font-size:10px;font-weight:600;
  letter-spacing:.28em;text-transform:uppercase;
  color:var(--gray-1);
  margin:0;
}
.eyebrow--lit{color:var(--gray-2)}

.vert{
  position:absolute;
  writing-mode:vertical-rl;
  font-size:8px;font-weight:600;
  letter-spacing:.24em;text-transform:uppercase;
  white-space:nowrap;
}

/* --- 4. HOME ------------------------------------------------------------- */
/* hero */
.hero{
  position:relative;
  min-height:88vh;
  display:flex;flex-direction:column;
  overflow:hidden;
  background:var(--ink);
  isolation:isolate;
}
.hero__img{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;object-position:52% 42%;
  z-index:-2;
}
.hero__scrim{
  position:absolute;inset:0;z-index:-1;
  background:
    linear-gradient(180deg,rgba(16,13,10,.84) 0%,rgba(16,13,10,.36) 26%,rgba(16,13,10,.16) 46%,rgba(16,13,10,.66) 78%,rgba(16,13,10,.90) 100%),
    linear-gradient(95deg,rgba(16,13,10,.58) 0%,rgba(16,13,10,.06) 58%);
}

.nav{
  position:relative;z-index:2;
  padding-top:clamp(18px,2.4vw,30px);
  display:flex;align-items:baseline;justify-content:space-between;
  gap:20px;flex-wrap:wrap;
}
.nav__mark{
  font-size:12px;font-weight:700;letter-spacing:.3em;
  text-transform:uppercase;color:var(--paper);
  text-decoration:none;
}
.nav__mark span{font-weight:300}
.nav__links{display:flex;gap:clamp(16px,2.4vw,34px)}
.nav__links a{
  font-size:10px;font-weight:600;letter-spacing:.24em;
  text-transform:uppercase;color:var(--paper);
  text-decoration:none;opacity:.7;
  padding-block:6px;
  transition:opacity .25s ease;
}
.nav__links a:hover,.nav__links a:focus-visible{opacity:1}

.hero__body{
  position:relative;z-index:2;
  flex:1;
  display:flex;flex-direction:column;
  justify-content:space-between;
  gap:clamp(40px,7vh,90px);
  padding-block:clamp(30px,6vh,64px) clamp(34px,7vh,78px);
}

.wordmark{
  margin:0;
  font-weight:700;
  font-stretch:92%;
  font-size:clamp(2.7rem,13.4vw,11.8rem);
  line-height:.88;
  letter-spacing:.008em;
  color:var(--paper);
  white-space:nowrap;
}
.wordmark span{font-weight:200;letter-spacing:.05em}

.hero__low{
  display:grid;
  grid-template-columns:minmax(0,1fr);
  gap:clamp(22px,3.4vw,40px);
  align-items:end;
}
@media(min-width:900px){
  .hero__low{grid-template-columns:minmax(0,1.35fr) minmax(0,.85fr)}
}

h1.hl{margin:0;text-wrap:balance}
.hl__caps{
  display:block;
  font-weight:600;
  font-size:clamp(1.1rem,3.3vw,2.35rem);
  line-height:1.06;
  letter-spacing:.005em;
  text-transform:uppercase;
  color:var(--paper);
  opacity:.92;
}
.hl__big{
  display:inline-block;position:relative;
  font-weight:200;
  font-stretch:96%;
  font-size:clamp(3.1rem,9.8vw,7.6rem);
  line-height:.98;letter-spacing:-.028em;
  color:var(--paper);
  margin-top:clamp(6px,1.2vw,16px);
  padding-inline:clamp(8px,1.6vw,24px);
}
.hl__ring{
  position:absolute;left:0;top:50%;
  width:100%;height:126%;
  transform:translateY(-50%) rotate(-1.4deg);
  pointer-events:none;overflow:visible;
}
.hl__ring path{
  fill:none;stroke:var(--paper);stroke-width:1.6;
  stroke-linecap:round;opacity:.45;
  vector-effect:non-scaling-stroke;
}

.hero__aside{display:flex;flex-direction:column;gap:20px}
.hero__sub{
  margin:0;max-width:34ch;
  font-size:clamp(.94rem,1.3vw,1.05rem);
  line-height:1.55;color:var(--paper);opacity:.82;
}

.cta{
  align-self:flex-start;
  display:inline-flex;align-items:center;gap:14px;
  padding:16px 26px 16px 0;
  font-size:11px;font-weight:700;letter-spacing:.28em;
  text-transform:uppercase;text-decoration:none;
  color:var(--paper);
  border-bottom:1px solid rgba(232,229,223,.4);
  transition:border-color .3s ease,gap .3s ease;
  min-height:44px;
}
.cta:hover,.cta:focus-visible{border-color:var(--paper);gap:22px}
.cta svg{width:44px;height:15px;flex:none;overflow:visible}
.cta svg path{fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round}

.hero__edge{
  right:calc(var(--gutter) * .32);
  top:32%;
  color:#D4CFC7;
  text-shadow:0 1px 10px rgba(16,13,10,.95),0 0 3px rgba(16,13,10,.8);
  z-index:2;
}
@media(max-width:899px){.hero__edge{display:none}}

/* statement */
.statement{padding-block:clamp(78px,13vh,170px)}
.statement__grid{
  display:grid;row-gap:clamp(34px,5vw,56px);column-gap:var(--col-gap);
  grid-template-columns:minmax(0,1fr);
}
@media(min-width:900px){
  .statement__grid{grid-template-columns:repeat(4,minmax(0,1fr));align-items:start}
  .statement__grid > *{grid-column:span 2}
}

.neg{
  margin:26px 0 0;
  font-weight:200;
  font-stretch:98%;
  font-size:clamp(1.85rem,4.7vw,3.1rem);
  line-height:1.2;letter-spacing:-.024em;
  color:var(--gray-1);
}
.neg .is{
  display:block;margin-top:.5em;
  color:var(--ink);font-weight:400;
}
.neg .is b{font-weight:600}

.statement__note{
  margin:clamp(28px,3.6vw,44px) 0 0;
  max-width:48ch;font-size:1rem;line-height:1.72;color:var(--gray-1);
}
.statement__note strong{color:var(--ink);font-weight:600}

.plate{position:relative;margin:0}
.plate img{width:100%;height:auto;object-fit:cover}
/* program */
.prog{padding-block:clamp(56px,10vh,120px) clamp(78px,13vh,168px)}
.prog__head{
  display:flex;justify-content:space-between;align-items:baseline;
  gap:24px;flex-wrap:wrap;padding-bottom:22px;
}
.prog__list{list-style:none;margin:0;padding:0}
.item{
  display:grid;gap:8px clamp(20px,3vw,44px);
  grid-template-columns:minmax(0,1fr);
  padding-block:clamp(22px,3.2vw,36px);
  border-top:1px solid var(--rule);
}
.item:last-child{border-bottom:1px solid var(--rule)}
.item__word{
  margin:0;
  font-weight:600;
  font-stretch:88%;
  font-size:clamp(2rem,6.2vw,4.1rem);
  line-height:.96;letter-spacing:-.026em;
  text-transform:uppercase;color:var(--ink);
  transition:transform .45s cubic-bezier(.2,.7,.3,1),opacity .3s ease;
}
.item__gloss{
  margin:0;max-width:46ch;
  font-size:1rem;line-height:1.62;
  color:var(--gray-1);
}
.item:hover .item__word{transform:translateX(9px)}

@media(min-width:900px){
  .item{grid-template-columns:repeat(4,minmax(0,1fr));column-gap:var(--col-gap);align-items:baseline}
  .item__word{grid-column:1/3}
  .item__gloss{grid-column:3/5}
}

/* experiment */
.exp{
  position:relative;
  background:var(--ink);color:var(--paper);
  padding-block:clamp(84px,15vh,190px);
  overflow:hidden;
}
.exp__edge{
  left:calc(var(--gutter) * .3);top:16%;
  color:var(--rule-ink);
}
@media(max-width:899px){.exp__edge{display:none}}

.exp__grid{
  display:grid;row-gap:clamp(34px,5vw,56px);column-gap:var(--col-gap);
  grid-template-columns:minmax(0,1fr);
}
@media(min-width:900px){
  .exp__grid{grid-template-columns:repeat(4,minmax(0,1fr));align-items:start}
  .exp__grid > *{grid-column:span 2}
}

.exp h2{
  margin:26px 0 0;
  font-weight:200;
  font-stretch:98%;
  font-size:clamp(1.85rem,4.7vw,3.1rem);
  line-height:1.2;letter-spacing:-.024em;
  color:var(--gray-2);text-wrap:balance;
}
.exp h2 em{font-style:normal;color:var(--paper);display:block}

/* body copy only: must not catch the eyebrow or the rotated edge caption */
.exp__grid p:not(.eyebrow){
  margin:0 0 18px;max-width:48ch;
  font-size:1rem;line-height:1.75;color:var(--gray-3);
}
.exp__grid p:not(.eyebrow):last-of-type{margin-bottom:0}

.recombine{
  margin-top:clamp(40px,6vw,72px);
  padding-top:26px;border-top:1px solid var(--rule-ink);
  display:flex;flex-wrap:wrap;align-items:center;
  gap:10px clamp(10px,1.6vw,20px);
}
.recombine span{
  font-size:clamp(10px,1.2vw,12px);font-weight:600;
  letter-spacing:.22em;text-transform:uppercase;color:var(--paper);
}
.recombine i{
  font-style:normal;color:var(--gray-2);
  font-size:clamp(9px,1vw,11px);
}

/* community */
.people{padding-block:clamp(78px,13vh,170px)}
.people__grid{
  display:grid;row-gap:clamp(40px,6vw,56px);column-gap:var(--col-gap);
  grid-template-columns:minmax(0,1fr);
  align-items:start;
}
@media(min-width:900px){
  .people__grid{grid-template-columns:repeat(4,minmax(0,1fr))}
  .people__grid > *{grid-column:span 2}
}
.bio+.bio{margin-top:clamp(40px,5.5vw,64px)}
.bio h3{
  margin:16px 0 0;
  font-weight:600;
  font-stretch:90%;
  font-size:clamp(1.5rem,3.4vw,2.25rem);
  line-height:1.06;letter-spacing:-.022em;
  text-transform:uppercase;color:var(--ink);
}
.bio__logo{margin:18px 0 0;line-height:0}
.bio__logo img{width:clamp(168px,21vw,206px);height:auto}
/* stacked/portrait logo: match optical weight by capping height, not width */
.bio__logo--tall img{width:auto;height:clamp(96px,12vw,122px)}

.bio__role{
  margin:11px 0 0;
  font-size:10px;font-weight:600;
  letter-spacing:.26em;text-transform:uppercase;
  color:var(--gray-1);
}
.bio p.bio__txt{
  margin:16px 0 0;max-width:46ch;
  font-size:.97rem;line-height:1.72;color:var(--gray-1);
}

/* close */
.close{
  padding-block:clamp(78px,13vh,175px);
  border-top:1px solid var(--rule);
}
.come{
  margin:0;
  font-weight:700;
  font-stretch:86%;
  font-size:clamp(2.4rem,10.6vw,8.6rem);
  line-height:.94;letter-spacing:-.032em;
  text-transform:uppercase;color:var(--ink);
}

.close__grid{
  margin-top:clamp(44px,6vw,80px);
  padding-top:clamp(26px,3.4vw,40px);
  border-top:1px solid var(--rule);
  display:grid;row-gap:clamp(26px,4vw,40px);column-gap:var(--col-gap);
  grid-template-columns:minmax(0,1fr);
}
@media(min-width:560px){
  .close__grid{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
}
@media(min-width:900px){
  .close__grid{grid-template-columns:repeat(4,minmax(0,1fr))}
}
.fact{margin:0}
.fact dt{
  font-size:10px;font-weight:600;letter-spacing:.26em;
  text-transform:uppercase;color:var(--gray-1);
}
.fact dd{
  margin:12px 0 0;
  font-weight:400;
  font-size:clamp(1.1rem,2vw,1.45rem);
  line-height:1.3;letter-spacing:-.01em;color:var(--ink);
}
.fact dd small{
  display:block;margin-top:7px;
  font-size:12px;font-weight:400;
  letter-spacing:.03em;color:var(--gray-1);
}

.rsvp{
  display:inline-flex;align-items:center;gap:16px;
  background:var(--ink);color:var(--paper);
  padding:20px 34px;min-height:44px;
  font-size:11px;font-weight:700;letter-spacing:.3em;
  text-transform:uppercase;text-decoration:none;
  border:1px solid var(--ink);
  transition:background .3s ease,gap .3s ease,color .3s ease;
}
.rsvp:hover,.rsvp:focus-visible{background:var(--ink-2);gap:24px}
.rsvp svg{width:38px;height:14px;flex:none;overflow:visible}
.rsvp svg path{fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round}

.rsvp--ghost{
  background:transparent;color:var(--ink);
  border:1px solid var(--ink);
}
.rsvp--ghost:hover,.rsvp--ghost:focus-visible{background:var(--ink);color:var(--paper)}

/* two doors: come along, or help build it */
.doors{
  margin-top:clamp(44px,6vw,78px);
  padding-top:clamp(30px,4vw,46px);
  border-top:1px solid var(--rule);
  display:grid;row-gap:clamp(34px,5vw,56px);column-gap:var(--col-gap);
  grid-template-columns:minmax(0,1fr);
}
@media(min-width:900px){
  .doors{grid-template-columns:repeat(4,minmax(0,1fr))}
  .doors > *{grid-column:span 2}
}
.door{display:flex;flex-direction:column;align-items:flex-start;gap:18px}
.door h3{
  margin:0;
  font-weight:600;
  font-size:clamp(1.15rem,2.1vw,1.5rem);
  line-height:1.2;letter-spacing:-.018em;color:var(--ink);
}
.door p{
  margin:0;max-width:42ch;
  font-size:.97rem;line-height:1.66;color:var(--gray-1);
}
.ways{
  list-style:none;margin:0;padding:0;
  display:flex;flex-direction:column;gap:8px;width:100%;
}
.ways li{
  display:flex;gap:12px;align-items:baseline;
  font-size:.94rem;line-height:1.5;color:var(--gray-1);
  padding-bottom:8px;border-bottom:1px solid var(--rule);
}
.door__alt{
  margin:0;font-size:13px;line-height:1.5;color:var(--gray-1);
}
.door__alt a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule);padding-bottom:1px}
.door__alt a:hover,.door__alt a:focus-visible{border-bottom-color:var(--ink)}

.ways b{
  flex:none;min-width:8.5em;
  font-weight:600;font-size:10px;letter-spacing:.2em;
  text-transform:uppercase;color:var(--ink);
}

/* --- 5. FOOTER ----------------------------------------------------------- */
.foot{
  background:var(--ink);color:var(--paper);
  padding-block:clamp(48px,7vh,80px);
}
.foot__top{
  display:grid;row-gap:clamp(28px,4vw,44px);column-gap:var(--col-gap);
  grid-template-columns:minmax(0,1fr);
}
@media(min-width:560px){
  .foot__top{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(min-width:900px){
  .foot__top{grid-template-columns:repeat(4,minmax(0,1fr))}
  .foot__top > div:first-child{grid-column:span 2}
}
.foot__mark{
  margin:0;
  font-size:clamp(1.45rem,4.2vw,2.5rem);font-weight:700;
  font-stretch:92%;
  letter-spacing:.012em;line-height:1;color:var(--paper);
}
.foot__mark span{font-weight:200;letter-spacing:.05em}
.foot__tag{
  margin:16px 0 0;max-width:32ch;
  font-weight:300;
  font-size:1rem;line-height:1.5;color:var(--gray-2);
}
.fcol h4{
  margin:0 0 14px;
  font-size:10px;font-weight:600;letter-spacing:.26em;
  text-transform:uppercase;color:var(--gray-2);
}
.fcol ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.fcol li{display:flex;flex-direction:column;gap:5px;align-items:flex-start}
.fcol a.sub{font-size:12px;color:var(--gray-2);border-bottom-color:var(--rule-ink)}
.fcol a.sub:hover,.fcol a.sub:focus-visible{color:var(--paper);border-bottom-color:var(--paper)}
.fcol a,.fcol span{
  font-size:13px;line-height:1.5;color:var(--paper);
  text-decoration:none;
}
.fcol a{
  border-bottom:1px solid var(--rule-ink);
  padding-bottom:2px;display:inline-block;
  transition:border-color .25s ease;
}
.fcol a:hover,.fcol a:focus-visible{border-color:var(--paper)}

.foot__base{
  margin-top:clamp(40px,6vh,72px);padding-top:22px;
  border-top:1px solid var(--rule-ink);
  display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
  font-size:10px;font-weight:600;letter-spacing:.22em;
  text-transform:uppercase;color:var(--gray-2);
}

/* --- 6. FOCUS + MOTION --------------------------------------------------- */
a:focus-visible,button:focus-visible{
  outline:2px solid var(--ink);outline-offset:4px;
}
.hero a:focus-visible,.exp a:focus-visible,.foot a:focus-visible{outline-color:var(--paper)}

.rise{animation:rise .95s cubic-bezier(.16,.84,.36,1) both}
.rise-2{animation-delay:.1s}
.rise-3{animation-delay:.2s}
@keyframes rise{from{transform:translateY(16px)}to{transform:none}}

@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
}

/* ==========================================================================
   7. SIMPLE PAGE: 404.html
   Reuses .wrap, .grain, .eyebrow and .rsvp from above; only layout differs.
   ========================================================================== */
.page-simple{display:flex;flex-direction:column;min-height:100vh}

.page-simple .top{padding-block:clamp(22px,3vw,34px)}
.page-simple .mark{
  font-size:12px;font-weight:700;letter-spacing:.3em;
  text-transform:uppercase;color:var(--ink);text-decoration:none;
}
.page-simple .mark span{font-weight:300}

.page-simple main{
  flex:1;display:flex;align-items:center;
  padding-block:clamp(50px,10vh,120px);
}
